# Copy to .env.local for local development (never commit .env.local). Local Supabase values come
# from `npx supabase status -o env` (this repo's stack: db 55322, api 55321). One file serves both
# apps locally; each reads only its own lines (D-068).

# --- web (apps/web): the UI. It never reaches the database; it calls the api. ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY from `npx supabase status -o env`>
# N-2.4: where web's server calls the api (127.0.0.1 only, never public).
API_URL=http://127.0.0.1:3003

# --- api (apps/api): the data, the rules, the crypto and the files. ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# N-2.3: the api verifies sign-ins against this project's JWKS. Only a project still on the
# legacy shared JWT secret (HS256) also needs SUPABASE_JWT_SECRET.
SUPABASE_URL=http://127.0.0.1:55321
# SUPABASE_JWT_SECRET=<JWT_SECRET from `npx supabase status -o env`; legacy projects only>
# N-3.8: the password check before a fingerprint set-up (the same anon key as above).
SUPABASE_ANON_KEY=<ANON_KEY from `npx supabase status -o env`>
# 32 random bytes, base64 (AES-256-GCM for saved card details). Locally the E2E test key works:
#   node -e "console.log(Buffer.alloc(32, 7).toString('base64'))"
# In production, generate a real one and back it up (deploy/README.md).
CARD_SECRET_KEY=<base64 32-byte key>
# Dev ports: web 3000, api 3003 (E2E uses 3001/3002, the parity harness 3011/3012).
API_PORT=3003
