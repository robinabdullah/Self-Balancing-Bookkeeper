# Copy to .env.local for local development (never commit .env.local). Local Supabase values come
# from `npx supabase status -o env` (this repo's stack: db 55322, api 55321).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY from `npx supabase status -o env`>
# 32 random bytes, base64 (AES-256-GCM for saved card details). Locally the E2E test key works:
#   node -e "console.log(Buffer.alloc(32, 7).toString('base64'))"
# In production, generate a real one and back it up (deploy/README.md).
CARD_SECRET_KEY=<base64 32-byte key>
