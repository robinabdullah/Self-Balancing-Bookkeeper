{
  "name": "@mbl/api",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "webpack-cli --mode production",
    "dev": "webpack-cli --mode development && concurrently -k -n build,api \"webpack-cli --mode development --watch\" \"node --watch --env-file-if-exists=../../.env.local dist/main.js\"",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@mbl/db": "*",
    "@mbl/domain": "*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@react-pdf/renderer": "^4.9.0",
    "@simplewebauthn/server": "13.3.3",
    "@supabase/supabase-js": "^2.117.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "react": "19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "swc-loader": "^0.2.7",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3"
  }
}
