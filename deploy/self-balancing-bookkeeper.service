# Self-Balancing Bookkeeper web: the Next.js standalone build that scripts/deploy.sh copies to
# /var/www/self-balancing-bookkeeper (D-031, D-071). Install as
# /etc/systemd/system/self-balancing-bookkeeper.service. See deploy/README.md.
[Unit]
Description=Self-Balancing Bookkeeper (Next.js)
After=network-online.target self-balancing-bookkeeper-api.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/self-balancing-bookkeeper/apps/web
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
# Loopback only: nginx is the public side. The port must match deploy/nginx.conf.
Environment=PORT=4007
Environment=HOSTNAME=127.0.0.1
# N-7.1: the api, on the port set in self-balancing-bookkeeper-api.service.
Environment=API_URL=http://127.0.0.1:4006
# Node comes from nvm: after an nvm upgrade, update this path and run `systemctl daemon-reload`.
ExecStart=/home/ubuntu/.nvm/versions/node/v24.22.1/bin/node --env-file=/var/www/self-balancing-bookkeeper/web.env /var/www/self-balancing-bookkeeper/apps/web/server.js
Restart=on-failure
RestartSec=5
# Keep the shared VPS safe for the other apps.
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
